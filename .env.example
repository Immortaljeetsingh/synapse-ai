# ==========================================
# SYNAPSE AI - Environment Configuration Example
# ==========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit your real .env.local file to version control.

# Primary AI Provider ('openrouter', 'openai', 'groq', 'deepseek', 'together', 'ollama', or 'local')
AI_PROVIDER=openrouter

# Primary AI Model ID
AI_MODEL=openai/gpt-oss-20b:free

# Primary Provider Base URL
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama (Local): http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# AI API Key (Server-side only. Required for cloud providers, optional for Ollama)
AI_API_KEY=your_api_key_here

# Optional: Port configuration (default: 3000)
PORT=3000

# Optional: Host configuration (default: 0.0.0.0 or localhost)
HOST=0.0.0.0
